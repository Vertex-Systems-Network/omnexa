{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omnexa:quality:gates:v1",
  "title": "Omnexa Quality Gate Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["change_id", "source_sha", "gates"],
  "properties": {
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_version": {
      "type": ["string", "null"]
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "state"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "class": {
            "type": "string",
            "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8"]
          },
          "state": {
            "type": "string",
            "enum": ["PASS", "FAIL", "BLOCKED", "NOT RUN", "N/A"]
          },
          "command": {
            "type": ["string", "null"]
          },
          "runner": {
            "type": ["string", "null"]
          },
          "reference": {
            "type": ["string", "null"]
          },
          "reason": {
            "type": ["string", "null"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": ["BLOCKED", "N/A"]
                }
              },
              "required": ["state"]
            },
            "then": {
              "required": ["reason"],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "minLength": 1},
          "sbom": {"type": ["string", "null"]},
          "provenance": {"type": ["string", "null"]}
        }
      }
    }
  }
}