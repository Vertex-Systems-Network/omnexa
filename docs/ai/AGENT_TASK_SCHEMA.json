{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnexa.local/schemas/agent-task-v1.json",
  "title": "Omnexa Agent Task Record v1",
  "description": "Planning/governance schema for bounded development-agent tasks. A record does not grant authority beyond STATE.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "agent_id",
    "role",
    "base_sha",
    "branch",
    "phase",
    "work_package",
    "owner",
    "purpose",
    "status",
    "read_paths",
    "write_paths",
    "forbidden_paths",
    "shared_paths",
    "depends_on",
    "risk_tier",
    "required_gates",
    "instruction_check"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "phase": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "work_package": {
      "type": "string",
      "pattern": "^P[0-9]{2}\\.[0-9]{2}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "claimed",
        "active",
        "blocked",
        "review",
        "done",
        "released",
        "cancelled"
      ]
    },
    "read_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "write_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "shared_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "risk_tier": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "required_gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "migration_reservation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "owner",
        "path",
        "version",
        "data_budget"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "data_budget": {
          "type": "string"
        }
      }
    },
    "contract_reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "version",
          "owner"
        ],
        "properties": {
          "kind": {
            "enum": [
              "api",
              "capability",
              "event",
              "permission",
              "schema"
            ]
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "instruction_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked",
        "readme_delta"
      ],
      "properties": {
        "checked": {
          "const": true
        },
        "readme_delta": {
          "enum": [
            "none",
            "updated-required"
          ]
        }
      }
    },
    "branch": {
      "type": "string",
      "minLength": 1
    }
  }
}
