{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnexa.local/schemas/agent-slot-v1.json",
  "title": "Omnexa Multi-Agent Worker Slot v1",
  "description": "Machine-readable worker-slot record for Supervisor-led repository onboarding. A slot never grants authority beyond canonical STATE.json and the active governed wave plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slot_id",
    "phase",
    "work_package",
    "module",
    "branch",
    "status",
    "start_status",
    "last_synced_main_sha",
    "write_paths",
    "depends_on",
    "merge_order"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "slot_id": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "pattern": "^P[0-9]{2}$"},
    "work_package": {"type": "string", "pattern": "^P[0-9]{2}\\.[0-9]{2}$"},
    "module": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "occupied", "blocked", "completed", "retired"]},
    "agent_id": {"type": ["string", "null"], "minLength": 1},
    "start_status": {"enum": ["unassigned", "assigned", "ready", "active", "blocked", "review", "done"]},
    "assigned_from_main_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "last_synced_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "write_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "merge_order": {"type": "integer", "minimum": 1},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "open"}}, "required": ["status"]},
      "then": {
        "properties": {
          "agent_id": {"type": "null"},
          "start_status": {"const": "unassigned"},
          "assigned_from_main_sha": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "occupied"}}, "required": ["status"]},
      "then": {
        "required": ["agent_id", "assigned_from_main_sha"],
        "properties": {
          "agent_id": {"type": "string", "minLength": 1},
          "assigned_from_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    }
  ]
}
